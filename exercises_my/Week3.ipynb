    "import numpy as np;\n",
    "import matplotlib.pyplot as plt;\n",
    "\n",
    "#Exercise 1\n",
    "\n",
    "def p(x):\n",
    "    if 0 < x < np.Pi: \n",
    "        return 1/2 *np.sin(x);\n",
    "    else:\n",
    "        return 0;\n",
    "\n",
    "\n",
    "test = np.arange(0,2,0.1)\n",
    "\n",
    "plt.plot(p(test))"
